{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEarthdataSecret",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "REPLACE_WITH_EARTHDATA_SECRET_ARN"
    },
    {
      "Sid": "ReadWriteOutputBucket",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:ListBucket"],
      "Resource": [
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME",
        "arn:aws:s3:::REPLACE_WITH_BUCKET_NAME/*"
      ]
    }
  ]
}
