# Copy to .env and fill in real values. .env is gitignored - never commit it.
# Used by `docker compose up` / `docker run --env-file .env` (see README.md).

# NASA Earthdata Login (urs.earthdata.nasa.gov) - one of the accounts in
# secrets/earthdata_accounts.json, or your own.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# AWS credentials for the S3 bucket (matt-achem-bucket2 by default). Use a
# key scoped to docs/claude-login-policy.json, not root/admin credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-west-2
